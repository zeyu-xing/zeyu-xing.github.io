{
    "name": "Zeyu Xing website preview",
    "dockerComposeFile": "../docker-compose.yaml",
    "service": "jekyll-site",
    "remoteEnv": {
        "VSCODE_SERVER_DIR": "/home/vscode/.vscode-server"
    },
    "workspaceFolder": "/usr/src/app",
    "remoteUser": "vscode",
    "forwardPorts": [4000],
    "portsAttributes": {
        "4000": {
            "label": "Website preview",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "bundle install",
    "postStartCommand": "nohup bash .devcontainer/start-preview.sh > /tmp/zeyu-homepage-preview.log 2>&1 < /dev/null &"
}
